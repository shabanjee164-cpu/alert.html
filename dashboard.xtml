        <div class="percent-box percent-box-green"><div class="percent-label">🩺 علامات پرسنٹیج</div><div class="percent-value" id="symptomPercentageValue">0%</div></div>
        <div class="percent-box percent-box-purple"><div class="percent-label">📈 مجموعی بہتری</div><div class="percent-value" id="overallImprovementValue">0%</div></div>
