    <div class="card" style="border-right: 5px solid var(--warning); background: #fffdf4;">
        <div class="section-heading" style="color:var(--warning);">🍽️ ڈائٹ روٹین سسٹم</div>

        <div style="display: flex; justify-content: center; margin-bottom: 12px;">
            <button class="setting-btn-pro" onclick="toggleDietSettingsPanel()">⚙️ سیٹنگ</button>
        </div>

        <div id="dietSettingsPanel" class="inline-settings-panel diet-panel">
            <div style="font-weight: bold; font-size: 12px; color: var(--warning); margin-bottom: 8px; text-align:center;">⚙️ ڈائٹ روٹین کنٹرول پینل</div>
            <div class="btn-group-custom">
                <button class="btn btn-secondary" onclick="selectAllDietItems()">✅ ال سلیکٹ</button>
                <button class="btn btn-primary" onclick="deleteSelectedDietItems()">🗑️ سلیکٹڈ ڈیلیٹ</button>
                <button class="btn btn-danger" onclick="clearAllDietItems()">❌ ال ڈیلیٹ</button>
                <button class="btn btn-success" onclick="window.print()">🖨️ پرنٹ</button>
                <button class="btn btn-secondary" onclick="toggleDietSettingsPanel()">✖️ کلوز</button>
            </div>
        </div>

        <div style="margin-bottom: 14px; text-align: center;">
            <label style="font-weight: bold; font-size: 13px; display: block; margin-bottom: 6px; color: #334155;">ممبر سلیکٹ کریں:</label>
            <select id="dietMemberSelect" class="select-field" style="max-width:300px; margin:0 auto; text-align:center;">
                <option value="علی">علی</option>
                <option value="احمد">احمد</option>
            </select>
        </div>

        <div style="margin-bottom: 14px; text-align: center;">
            <label style="font-weight: bold; font-size: 13px; display: block; margin-bottom: 6px; color: #0f172a;">⏰ کھانے یا پینے کا وقت (Time Slot):</label>
            <select id="mealTimeSlot" class="select-field" style="max-width:300px; margin:0 auto; text-align:center; background:#fffbeb; border:1px solid #d97706;">
                <option value="صبح کا ناشتہ">1. صبح کا ناشتہ</option>
                <option value="دوپہر کا کھانا">2. دوپہر کا کھانا</option>
                <option value="شام کی چائے">3. شام کی چائے</option>
                <option value="رات کا کھانا">4. رات کا کھانا</option>
            </select>
        </div>

        <div style="max-height: 220px; overflow-y: auto; border: 1px solid #fde68a; border-radius: 8px; padding: 10px; background: #ffffff; margin-bottom: 16px;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">

                <details class="diet-item-section" open><summary>1️⃣ گندم / روٹی آئٹم</summary><div class="diet-item-content"><input type="checkbox" class="diet-item-chk" style="width:15px;height:15px;" checked><span>گندم روٹی / نان</span><select id="dietVal1"><option>1</option><option>2</option><option>0</option></select></div></details>

                <details class="diet-item-section" open><summary>2️⃣ دودھ / لسی آئٹم</summary><div class="diet-item-content"><input type="checkbox" class="diet-item-chk" style="width:15px;height:15px;" checked><span>خالص دودھ / لسی</span><select id="dietVal2"><option>گلاس</option><option>کپ</option><option>0</option></select></div></details>

                <details class="diet-item-section" open><summary>3️⃣ مکس جنک فوڈ</summary><div class="diet-item-content"><input type="checkbox" class="diet-item-chk" style="width:15px;height:15px;"><span>جنک فوڈ / سنیکس</span><select id="dietVal3"><option>0</option><option>تھوڑا</option><option>زیادہ</option></select></div></details>

            </div>
        </div>

        <div style="margin-bottom: 16px;">
            <label style="font-weight: bold; font-size: 13px; display: block; margin-bottom: 6px; color: #334155;">ڈائٹ کی مزید تفصیل:</label>
            <textarea id="dietDetailedNotes" rows="3" placeholder="یہاں مزید تفصیل لکھیں..." class="select-field" style="font-weight:normal;"></textarea>
        </div>

        <button class="btn" style="background: #d97706; width: 100%; padding: 16px; font-size: 16px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);" onclick="saveMealRecordToStore()">💾 ڈائٹ روٹین محفوظ کریں (سیو)</button>
        <div id="dietStatusMsg" style="font-size: 13px; margin-top: 10px; font-weight: bold; text-align: center;"></div>
    </div>

