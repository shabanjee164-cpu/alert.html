</div><!-- container ختم -->


<!-- ================================================================
     سیکشن 11 شروع: تمام جاوا اسکرپٹ منطق (ایک جگہ، نام الگ الگ)
     ================================================================ -->
*
<script>
/* ---------- الرٹ ٹائمر ---------- */
let alertCountdown = 25;
let alertTimerId = null;
let alertSoundInterval = null;

function playBellSound() {
    try {
        let audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        let osc = audioCtx.createOscillator();
        let gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.type = "sine";
        osc.frequency.value = 900;
        gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.4);
    } catch (e) {
        console.log("Audio permission required");
    }
}

alertTimerId = setInterval(() => {
    alertCountdown--;
    const timerEl = document.getElementById('alertTimer');
    if (timerEl) timerEl.innerText = alertCountdown;

    if (alertCountdown <= 0) {
        clearInterval(alertTimerId);
        let alertBar = document.getElementById('alertTickerBar');
        alertBar.classList.add('continuous-blink');
        document.getElementById('alertMsgText').innerText = "🚨 وقت ختم! فوری توجہ فرمائیں - الرٹ جاری ہے!";
        alertSoundInterval = setInterval(playBellSound, 1000);
    }
}, 1000);

function skipAlertTicker() {
    if (alertSoundInterval) clearInterval(alertSoundInterval);
    if (alertTimerId) clearInterval(alertTimerId);
    document.getElementById('alertTickerBar').style.display = 'none';
}

/* ---------- ڈیوٹی ممبران روٹیشن ---------- */
const allMembers = [
    ["علی احمد", "محمد عثمان"],
    ["بلال حسن", "حمزہ خان"],
    ["طارق محمود", "یاسر عرفات"],
    ["سفیان علی", "زاہد خان"]
];

function updateDutyRoster() {
    let today = new Date();
    let dayOfYear = Math.floor((today - new Date(today.getFullYear(), 0, 0)) / (1000 * 60 * 60 * 24));
    let dutyGroupIndex = dayOfYear % allMembers.length;
    let currentPair = allMembers[dutyGroupIndex];

    document.getElementById('member1Name').innerText = currentPair[0];
    document.getElementById('member2Name').innerText = currentPair[1];

    let select = document.getElementById('leaveMemberSelect');
    select.innerHTML = `
        <option value="">-- ممبر منتخب کریں --</option>
        <option value="${currentPair[0]}">1. ${currentPair[0]}</option>
        <option value="${currentPair[1]}">2. ${currentPair[1]}</option>
    `;
}

function submitLeaveRequest() {
    let selectElement = document.getElementById('leaveMemberSelect');
    let selectedName = selectElement.value;
    let msgBox = document.getElementById('leaveStatusMsg');

    if (selectedName !== "") {
        msgBox.style.display = 'block';
        msgBox.style.background = '#ecfdf5';
        msgBox.style.color = '#047857';
        msgBox.style.borderColor = '#a7f3d0';
        msgBox.innerText = "✅ " + selectedName + " کی چھٹی باقاعدہ سبمٹ ہو گئی ہے۔";
    } else {
        msgBox.style.display = 'block';
        msgBox.style.background = '#fef2f2';
        msgBox.style.color = '#ef4444';
        msgBox.style.borderColor = '#fecaca';
        msgBox.innerText = "⚠️ براے مہربانی ڈراپ ڈاؤن لسٹ سے کسی ایک ممبر کا انتخاب کریں!";
    }
}

/* ---------- ٹاسک ٹریکر منطق ---------- */
const tasksList = [
    { title: "کمرے کی صفائی اور ترتیب", points: 10 },
    { title: "حاضری لاگ بک کی تیاری", points: 5 },
    { title: "سیکیورٹی کیمرہ چیکنگ", points: 10 },
    { title: "سامان کا جائزہ", points: 5 },
    { title: "لائٹس اور سوئچ چیکنگ", points: 5 },
    { title: "روزانہ کی فائنینشل رپورٹ", points: 10 }
];
let taskCurrentIndex=0, taskTotalPoints=0, selectedMemberTask="";
let memberTaskScores=JSON.parse(localStorage.getItem('memberTaskScores'))||{};
let memberTaskHistory=JSON.parse(localStorage.getItem('memberTaskHistory'))||{};
function getTaskMemberKey(member){return member==='علی'?'ali':(member==='احمد'?'ahmad':member);}
function getPerformanceGrade(points){const pct=Math.min(100,Math.round((points/45)*100));if(pct>=80)return'Excellent';if(pct>=60)return'Good';if(pct>=40)return'Average';return'Needs Improvement';}
function renderFinalResults(){const body=document.getElementById('finalResultTableBody');if(!body)return;body.innerHTML=['علی','احمد'].map(member=>{const points=Number(memberTaskScores[member]||0);return`<tr><td><b>${member}</b></td><td><span style="font-weight:bold;color:var(--success);">${points} پوائنٹس</span></td><td><span style="background:#e0f2fe;color:#0369a1;padding:4px 10px;border-radius:12px;font-size:12px;">${getPerformanceGrade(points)}</span></td></tr>`}).join('');}
function renderTaskHistory(){const list=document.getElementById('historyList');if(!list)return;const history=memberTaskHistory[selectedMemberTask]||[];list.innerHTML=history.length?history.map(item=>`<div class="history-item ${item.statusClass}"><span>${item.title} (${item.points} Pts)</span><span>${item.status}</span></div>`).join(''):'<div style="color:#94a3b8;text-align:center;padding:18px 0;font-size:12px;">اس ممبر کی ٹاسک ہسٹری ابھی خالی ہے۔</div>'; }
function startTasks(){selectedMemberTask=document.getElementById('memberSelect').value;if(!selectedMemberTask){document.getElementById('taskText').innerText='پہلے ممبر منتخب کریں';document.getElementById('taskPoints').innerText='0 Points';document.getElementById('totalScoreText').innerText='ٹوٹل پوائنٹس: 0';document.getElementById('historyList').innerHTML='';return;}taskCurrentIndex=0;taskTotalPoints=Number(memberTaskScores[selectedMemberTask]||0);renderTaskHistory();showTask();}
function showTask(){document.getElementById('totalScoreText').innerText=`ٹوٹل پوائنٹس: ${taskTotalPoints}`;if(taskCurrentIndex<tasksList.length){document.getElementById('taskText').innerText=tasksList[taskCurrentIndex].title;document.getElementById('taskPoints').innerText=`${tasksList[taskCurrentIndex].points} Points`;}else{document.getElementById('taskText').innerText='🎉 تمام کام مکمل!';document.getElementById('taskPoints').innerText=`حتمی اسکور: ${taskTotalPoints}`;}}
function submitTask(status){if(!selectedMemberTask){document.getElementById('taskText').innerText='⚠️ پہلے ممبر منتخب کریں!';return;}if(taskCurrentIndex>=tasksList.length)return;const currentTask=tasksList[taskCurrentIndex];const statusClass=status==='ہو گیا'?'status-done':(status==='نہیں ہوا'?'status-not-done':'status-na');if(status==='ہو گیا')taskTotalPoints+=currentTask.points;memberTaskScores[selectedMemberTask]=taskTotalPoints;if(!memberTaskHistory[selectedMemberTask])memberTaskHistory[selectedMemberTask]=[];memberTaskHistory[selectedMemberTask].unshift({title:currentTask.title,points:currentTask.points,status,statusClass});localStorage.setItem('memberTaskScores',JSON.stringify(memberTaskScores));localStorage.setItem('memberTaskHistory',JSON.stringify(memberTaskHistory));if(status==='کرنا نہیں تھا')addTaskTrackerSkippedRecord(selectedMemberTask,currentTask.title);renderTaskHistory();renderFinalResults();taskCurrentIndex++;showTask();}
function addTaskTrackerSkippedRecord(memberName,taskTitle){const memberKey=getTaskMemberKey(memberName);if(typeof skippedHistoryLogs==='undefined')return;if(skippedHistoryLogs.some(item=>item.source==='task-tracker'&&item.member===memberName&&item.task===taskTitle))return;skippedHistoryLogs.push({id:Date.now(),memberKey,member:memberName,task:taskTitle,reason:'ٹاسک ٹریکر سے اسکیپ کیا گیا',source:'task-tracker'});localStorage.setItem('skippedHistoryLogs',JSON.stringify(skippedHistoryLogs));if(typeof renderTasksUI==='function')renderTasksUI();}

/* ---------- اسکیپ اور ریموو منطق ---------- */
let memberTasks = JSON.parse(localStorage.getItem('memberActiveTasks')) || {
    ali: ["صبح کی چیکنگ", "شام کی رپورٹ", "ڈیٹا بیک اپ"],
    ahmad: ["سائٹ وزٹ", "صفائی کا معائنہ", "کیمپ کی سیکیورٹی"]
};

let skippedHistoryLogs = JSON.parse(localStorage.getItem('skippedHistoryLogs')) || [
    { id: 1, memberKey: "ali", member: "علی", task: "ہفتہ وار میٹنگ", reason: "طبی طبیعت ناساز تھی" }
];

function toggleSkipSettingsPanel() {
    let panel = document.getElementById('skipSettingsPanel');
    panel.style.display = (panel.style.display === 'block') ? 'none' : 'block';
}

function renderTasksUI() {
    const aliList = document.getElementById('ali-active-list');
    const ahmadList = document.getElementById('ahmad-active-list');

    if (memberTasks.ali.length === 0) {
        aliList.innerHTML = `<li style="color: #16a34a; padding: 4px 0; font-size: 12px;">تمام کام مکمل ہو چکے ہیں</li>`;
    } else {
        aliList.innerHTML = memberTasks.ali.map(task => `
            <li style="padding: 5px 0; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; font-size: 12px;">
                <span>• ${task}</span>
                <span style="background: rgba(2, 132, 199, 0.1); color: #0284c7; font-size: 0.75em; padding: 2px 6px; border-radius: 4px; font-weight: bold;">Active</span>
            </li>
        `).join('');
    }

    if (memberTasks.ahmad.length === 0) {
        ahmadList.innerHTML = `<li style="color: #16a34a; padding: 4px 0; font-size: 12px;">تمام کام مکمل ہو چکے ہیں</li>`;
    } else {
        ahmadList.innerHTML = memberTasks.ahmad.map(task => `
            <li style="padding: 5px 0; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; font-size: 12px;">
                <span>• ${task}</span>
                <span style="background: rgba(22, 163, 74, 0.1); color: #16a34a; font-size: 0.75em; padding: 2px 6px; border-radius: 4px; font-weight: bold;">Active</span>
            </li>
        `).join('');
    }

    updateTaskDropdown();
    renderMemberSkippedLists();
}

function renderMemberSkippedLists() {
    let aliContainer = document.getElementById('ali-skipped-scroll-list');
    let ahmadContainer = document.getElementById('ahmad-skipped-scroll-list');

    let aliSkipped = skippedHistoryLogs.filter(item => item.memberKey === 'ali');
    let ahmadSkipped = skippedHistoryLogs.filter(item => item.memberKey === 'ahmad');

    if (aliSkipped.length === 0) {
        aliContainer.innerHTML = '<div style="color: #94a3b8; text-align: center; padding: 10px 0; font-size: 12px;">کوئی اسکیپ نہیں ہوا۔</div>';
    } else {
        aliContainer.innerHTML = aliSkipped.map(item => `
            <div style="padding: 6px; border-bottom: 1px dashed #f1f5f9; display: flex; justify-content: space-between; align-items: center; font-size: 12px;">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <input type="checkbox" class="skipped-checkbox" data-id="${item.id}" style="width: 14px; height: 14px; cursor: pointer;">
                    <span><b>${item.task}</b> <span style="color: var(--golden);">(${item.reason})</span></span>
                </div>
                <button style="background: var(--danger); color: white; border: none; padding: 2px 6px; border-radius: 4px; font-size: 10px; cursor: pointer;" onclick="deleteSingleSkipped(${item.id})">ڈیلیٹ</button>
            </div>
        `).join('');
    }

    if (ahmadSkipped.length === 0) {
        ahmadContainer.innerHTML = '<div style="color: #94a3b8; text-align: center; padding: 10px 0; font-size: 12px;">کوئی اسکیپ نہیں ہوا۔</div>';
    } else {
        ahmadContainer.innerHTML = ahmadSkipped.map(item => `
            <div style="padding: 6px; border-bottom: 1px dashed #f1f5f9; display: flex; justify-content: space-between; align-items: center; font-size: 12px;">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <input type="checkbox" class="skipped-checkbox" data-id="${item.id}" style="width: 14px; height: 14px; cursor: pointer;">
                    <span><b>${item.task}</b> <span style="color: var(--golden);">(${item.reason})</span></span>
                </div>
                <button style="background: var(--danger); color: white; border: none; padding: 2px 6px; border-radius: 4px; font-size: 10px; cursor: pointer;" onclick="deleteSingleSkipped(${item.id})">ڈیلیٹ</button>
            </div>
        `).join('');
    }
}

function updateTaskDropdown() {
    const member = document.getElementById('skip-member-select').value;
    const taskSelect = document.getElementById('skip-task-select');
    const currentTasks = memberTasks[member];

    if (!currentTasks || currentTasks.length === 0) {
        taskSelect.innerHTML = `<option value="">کوئی کام موجود نہیں</option>`;
    } else {
        taskSelect.innerHTML = currentTasks.map(task => `<option value="${task}">${task}</option>`).join('');
    }
}

function submitAndRemoveTask() {
    const memberKey = document.getElementById('skip-member-select').value;
    const memberName = (memberKey === 'ali') ? 'علی' : 'احمد';
    const taskSelect = document.getElementById('skip-task-select');
    const selectedTask = taskSelect.value;
    const reasonInput = document.getElementById('skip-reason-input');
    const reason = reasonInput.value.trim();

    if (!selectedTask || memberTasks[memberKey].length === 0 || !reason) return;

    memberTasks[memberKey] = memberTasks[memberKey].filter(task => task !== selectedTask);

    skippedHistoryLogs.push({
        id: Date.now(),
        memberKey: memberKey,
        member: memberName,
        task: selectedTask,
        reason: reason
    });

    localStorage.setItem('memberActiveTasks', JSON.stringify(memberTasks));
    localStorage.setItem('skippedHistoryLogs', JSON.stringify(skippedHistoryLogs));

    renderTasksUI();
    reasonInput.value = '';
}

function deleteSingleSkipped(id) {
    skippedHistoryLogs = skippedHistoryLogs.filter(item => item.id !== id);
    localStorage.setItem('skippedHistoryLogs', JSON.stringify(skippedHistoryLogs));
    renderTasksUI();
}

function selectAllSkippedItems() {
    document.querySelectorAll('.skipped-checkbox').forEach(chk => chk.checked = true);
}

function deleteSelectedSkippedItems() {
    let checkboxes = document.querySelectorAll('.skipped-checkbox:checked');
    let idsToDelete = Array.from(checkboxes).map(chk => parseInt(chk.getAttribute('data-id')));
    if (idsToDelete.length === 0) return;

    skippedHistoryLogs = skippedHistoryLogs.filter(item => !idsToDelete.includes(item.id));
    localStorage.setItem('skippedHistoryLogs', JSON.stringify(skippedHistoryLogs));
    renderTasksUI();
}

function clearAllSkippedItems() {
    skippedHistoryLogs = [];
    localStorage.setItem('skippedHistoryLogs', JSON.stringify(skippedHistoryLogs));
    renderTasksUI();
}

/* ---------- علامات ٹریکر فارم منطق ---------- */
let selectedSymptomStatus = "1. ٹھیک ہے";

function handleSymptom(statusText) {
    selectedSymptomStatus = statusText;
    document.getElementById('symptomTitleText').innerText = `🔍 کیفیت: ${statusText}`;
}

function submitSymptomForm() {
    let member = document.getElementById('healthMemberSelect').value;
    let details = document.getElementById('symptomDetailedNotes').value;
    let statusMsgEl = document.getElementById('symptomStatusMsg');

    if (!details) {
        statusMsgEl.style.color = "#ef4444";
        statusMsgEl.innerText = "⚠️ براہ کرم تفصیل کا باکس پُر کریں!";
        return;
    }

    statusMsgEl.style.color = "#10b981";
    statusMsgEl.innerText = `✅ ${member} کے لیے اسٹیٹس (${selectedSymptomStatus}) کا ریکارڈ کامیابی سے سبمٹ ہو گیا!`;
    symptomHistoryLogs.push({id:Date.now(),member,symptom:document.getElementById('symptomTitleText').innerText.replace(/^🔍 (علامت|کیفیت):\s*/,''),status:selectedSymptomStatus,details,isPositive:['1. ٹھیک ہے','6. بہتر ہے پہلے سے'].includes(selectedSymptomStatus)});
    renderSymptomHistory();
    updateSummaryPercentages();
    setTimeout(() => { statusMsgEl.innerText = ""; }, 3500);
}

/* ---------- ڈائٹ روٹین سسٹم منطق ---------- */
function toggleDietSettingsPanel() {
    let panel = document.getElementById('dietSettingsPanel');
    panel.style.display = (panel.style.display === 'block') ? 'none' : 'block';
}

function selectAllDietItems() {
    document.querySelectorAll('.diet-item-chk').forEach(chk => chk.checked = true);
}

function deleteSelectedDietItems() {
    document.querySelectorAll('.diet-item-chk:checked').forEach(chk => chk.checked = false);
}

function clearAllDietItems() {
    document.querySelectorAll('.diet-item-chk').forEach(chk => chk.checked = false);
    document.getElementById('dietDetailedNotes').value = '';
}

function saveMealRecordToStore() {
    let member = document.getElementById('dietMemberSelect').value;
    let timeSlot = document.getElementById('mealTimeSlot').value;
    let statusMsgEl = document.getElementById('dietStatusMsg');

    statusMsgEl.style.opacity = "1";
    statusMsgEl.style.color = "#10b981";
    statusMsgEl.innerText = `✅ (${member}) کے لیے (${timeSlot}) کا ڈائٹ ریکارڈ کامیابی سے محفوظ ہو گیا!`;
    dietHistoryLogs.push({id:Date.now(),member,slot:timeSlot,v1:`گندم روٹی: ${document.getElementById('dietVal1').value}`,v2:`دودھ: ${document.getElementById('dietVal2').value}`,v3:`جنک: ${document.getElementById('dietVal3').value}`,isGood:document.getElementById('dietVal3').value==='0'});
    renderDietHistory();
    updateSummaryPercentages();
    setTimeout(() => { statusMsgEl.innerText = ""; }, 3500);
}

/* ---------- ڈائٹ ہسٹری ریکارڈ منطق ---------- */
let dietHistoryLogs = [
    { id: 1, slot: "صبح کا ناشتہ", v1: "گندم روٹی: 2", v2: "دودھ: 1 گلاس", v3: "جنک: 0", isGood: true },
    { id: 2, slot: "دوپہر کا کھانا", v1: "گندم روٹی: 1", v2: "دودھ: 0", v3: "جنک: تھوڑا", isGood: false },
    { id: 3, slot: "شام کی چائے", v1: "گندم روٹی: 0", v2: "دودھ: 1 کپ", v3: "جنک: 0", isGood: true },
    { id: 4, slot: "رات کا کھانا", v1: "گندم روٹی: 2", v2: "دودھ: 1 گلاس", v3: "جنک: 0", isGood: true },
    { id: 5, slot: "اگلا دن - ناشتہ", v1: "گندم روٹی: 1", v2: "دودھ: 1 کپ", v3: "جنک: 0", isGood: true },
    { id: 6, slot: "اگلا دن - دوپہر", v1: "گندم روٹی: 2", v2: "دودھ: 0", v3: "جنک: زیادہ", isGood: false }
];

function toggleDietHistorySettings() {
    let panel = document.getElementById('dietHistorySettingsPanel');
    panel.style.display = (panel.style.display === 'block') ? 'none' : 'block';
}

function renderDietHistory() {
    let dietCont = document.getElementById('dietHistoryLog');
    if (dietHistoryLogs.length === 0) {
        dietCont.innerHTML = '<div style="color: #64748b; text-align: center; padding: 40px 0;">کوئی ڈائٹ ہسٹری موجود نہیں۔</div>';
        return;
    }
    dietCont.innerHTML = dietHistoryLogs.map((item) => `
        <div class="log-row diet-row">
            <div class="row-left">
                <input type="checkbox" class="diet-history-checkbox" data-id="${item.id}" style="width: 16px; height: 16px; cursor: pointer;">
                <span>👤 <b>${item.member || 'ممبر'}</b> · ⏰ <b>${item.slot}</b> (${item.v1} | ${item.v2} | ${item.v3})</span>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="color:${item.isGood ? 'var(--success)' : 'var(--danger)'}; font-weight:bold; font-size: 11px;">
                    ${item.isGood ? '✅ اچھی خوراک' : '⚠️ جنک فوڈ'}
                </span>
                <button class="btn btn-danger" style="padding: 3px 8px; font-size: 11px;" onclick="deleteSingleDietItem(${item.id})">ڈیلیٹ</button>
            </div>
        </div>
    `).join('');
}

function deleteSingleDietItem(id) {
    dietHistoryLogs = dietHistoryLogs.filter(item => item.id !== id);
    renderDietHistory();
    updateSummaryPercentages();
}

function selectAllDietHistory() {
    document.querySelectorAll('.diet-history-checkbox').forEach(chk => chk.checked = true);
}

function deleteSelectedDietHistory() {
    let checkboxes = document.querySelectorAll('.diet-history-checkbox:checked');
    let idsToDelete = Array.from(checkboxes).map(chk => parseInt(chk.getAttribute('data-id')));
    if (idsToDelete.length === 0) return;
    dietHistoryLogs = dietHistoryLogs.filter(item => !idsToDelete.includes(item.id));
    renderDietHistory();
    updateSummaryPercentages();
}

function clearAllDietHistory() {
    dietHistoryLogs = [];
    renderDietHistory();
    updateSummaryPercentages();
}

/* ---------- علامات ہسٹری ریکارڈ منطق ---------- */
let symptomHistoryLogs = [
    { id: 1, member: "علی", symptom: "گیس / پیٹ میں ابھار", status: "1. ٹھیک ہے", isPositive: true },
    { id: 2, member: "احمد", symptom: "قبض کی شکایت", status: "2. نہیں ٹھیک", isPositive: false },
    { id: 3, member: "علی", symptom: "سر درد", status: "6. بہتر ہے پہلے سے", isPositive: true },
    { id: 4, member: "احمد", symptom: "چکر آنا", status: "8. مسئلہ بہت زیادہ ہے", isPositive: false },
    { id: 5, member: "علی", symptom: "معدے کی جلن", status: "3. تھوڑا مسئلہ ہے", isPositive: false },
    { id: 6, member: "احمد", symptom: "گیس / پیٹ میں ابھار", status: "1. ٹھیک ہے", isPositive: true }
];

function toggleSymptomHistorySettings() {
    let panel = document.getElementById('symptomHistorySettingsPanel');
    panel.style.display = (panel.style.display === 'block') ? 'none' : 'block';
}

function renderSymptomHistory() {
    let sympCont = document.getElementById('symptomHistoryLog');
    if (symptomHistoryLogs.length === 0) {
        sympCont.innerHTML = '<div style="color: #64748b; text-align: center; padding: 40px 0;">کوئی علامت ہسٹری موجود نہیں۔</div>';
        return;
    }
    sympCont.innerHTML = symptomHistoryLogs.map((item) => `
        <div class="log-row symptom-row">
            <div class="row-left">
                <input type="checkbox" class="symptom-history-checkbox" data-id="${item.id}" style="width: 16px; height: 16px; cursor: pointer;">
                <span>👤 <b>${item.member}</b>: ${item.symptom} ➔ <b style="color:var(--purple);">${item.status}</b></span>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="color:${item.isPositive ? 'var(--success)' : 'var(--danger)'}; font-weight:bold; font-size: 11px;">
                    ${item.isPositive ? '👍 بہتر' : '⚠️ مسئلہ'}
                </span>
                <button class="btn btn-danger" style="padding: 3px 8px; font-size: 11px;" onclick="deleteSingleSymptomItem(${item.id})">ڈیلیٹ</button>
            </div>
        </div>
    `).join('');
}

function deleteSingleSymptomItem(id) {
    symptomHistoryLogs = symptomHistoryLogs.filter(item => item.id !== id);
    renderSymptomHistory();
    updateSummaryPercentages();
}

function selectAllSymptomHistory() {
    document.querySelectorAll('.symptom-history-checkbox').forEach(chk => chk.checked = true);
}

function deleteSelectedSymptomHistory() {
    let checkboxes = document.querySelectorAll('.symptom-history-checkbox:checked');
    let idsToDelete = Array.from(checkboxes).map(chk => parseInt(chk.getAttribute('data-id')));
    if (idsToDelete.length === 0) return;
    symptomHistoryLogs = symptomHistoryLogs.filter(item => !idsToDelete.includes(item.id));
    renderSymptomHistory();
    updateSummaryPercentages();
}

function clearAllSymptomHistory() {
    symptomHistoryLogs = [];
    renderSymptomHistory();
    updateSummaryPercentages();
}

function updateSummaryPercentages(){const dietTotal=dietHistoryLogs.length,dietGood=dietHistoryLogs.filter(item=>item.isGood).length;const symptomTotal=symptomHistoryLogs.length,symptomPositive=symptomHistoryLogs.filter(item=>item.isPositive).length;const dietPct=dietTotal?Math.round(dietGood/dietTotal*100):0,symptomPct=symptomTotal?Math.round(symptomPositive/symptomTotal*100):0,overall=Math.round((dietPct+symptomPct)/2);const a=document.getElementById('dietPercentageValue'),b=document.getElementById('symptomPercentageValue'),c=document.getElementById('overallImprovementValue');if(a)a.innerText=`${dietPct}%`;if(b)b.innerText=`${symptomPct}%`;if(c)c.innerText=`${overall}%`;}

/* ---------- صفحہ لوڈ پر سب کچھ رینڈر ---------- */
document.addEventListener("DOMContentLoaded", function () {
    updateDutyRoster();
    renderTasksUI();
    renderFinalResults();
    renderDietHistory();
    renderSymptomHistory();
    updateSummaryPercentages();
});
</script>
